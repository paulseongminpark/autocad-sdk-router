{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariadne.local/schemas/e2_target_population_oracle.v1.schema.json",
  "title": "Independent native-display target population oracle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "oracle",
    "status",
    "claim_scope",
    "producer_receipt_required",
    "producer_receipt_path",
    "downstream_experiment_guard_required",
    "geometry_scope",
    "drawing_id",
    "evidence",
    "targets"
  ],
  "properties": {
    "schema": {"const": "ariadne.e2.target_population_oracle.v1"},
    "oracle": {"const": "autocad.native_display_membership.v1"},
    "status": {"const": "OBSERVED"},
    "claim_scope": {"const": "instrument_observation_only"},
    "producer_receipt_required": {"const": true},
    "producer_receipt_path": {"type": "string", "minLength": 1},
    "downstream_experiment_guard_required": {"const": true},
    "geometry_scope": {
      "enum": ["strict_layer_entities_v1", "linear_segments_v1"]
    },
    "drawing_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "layer",
          "native_source_entity_templates",
          "expected_source_segments",
          "native_visible_source_segments",
          "clipped_away_source_segments",
          "excluded_curved_source_segments",
          "excluded_degenerate_source_segments",
          "excluded_unsupported_entity_templates",
          "native_visible_segment_ids"
        ],
        "properties": {
          "target_id": {"type": "string", "minLength": 1},
          "layer": {"type": "string", "minLength": 1},
          "native_source_entity_templates": {"type": "integer", "minimum": 0},
          "expected_source_segments": {"type": "integer", "minimum": 0},
          "native_visible_source_segments": {"type": "integer", "minimum": 0},
          "clipped_away_source_segments": {"type": "integer", "minimum": 0},
          "excluded_curved_source_segments": {"type": "integer", "minimum": 0},
          "excluded_degenerate_source_segments": {"type": "integer", "minimum": 0},
          "excluded_unsupported_entity_templates": {"type": "integer", "minimum": 0},
          "native_visible_segment_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
