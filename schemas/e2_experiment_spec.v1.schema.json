{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariadne.local/schemas/e2_experiment_spec.v1.schema.json",
  "title": "E2 experiment specification",
  "type": "object",
  "required": ["schema", "experiment_id", "created_at", "target", "source", "evidence", "interventions"],
  "properties": {
    "schema": {"const": "e2.experiment_spec.v1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "target": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["path", "sha256", "read_only"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "read_only": {"const": true}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["native_ir", "adapter_ir", "world_ir"],
      "additionalProperties": {"type": "string"}
    },
    "interventions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  }
}
