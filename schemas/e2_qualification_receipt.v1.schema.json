{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariadne.local/schemas/e2_qualification_receipt.v1.schema.json",
  "title": "E2 instrument qualification receipt",
  "type": "object",
  "required": [
    "schema",
    "status",
    "experiment_id",
    "created_at",
    "source",
    "evidence",
    "gates",
    "scope_verdicts",
    "limitations",
    "authorization_scope",
    "downstream_experiment_gate",
    "outputs"
  ],
  "properties": {
    "schema": {"const": "e2.qualification_receipt.v1"},
    "status": {"$ref": "#/$defs/status"},
    "experiment_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["path", "sha256", "native_payload_sha256", "read_only"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "native_payload_sha256": {"$ref": "#/$defs/sha256"},
        "read_only": {"const": true}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/file_record"}
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gate", "status", "evidence"],
        "properties": {
          "gate": {"type": "string", "minLength": 1},
          "status": {"$ref": "#/$defs/status"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "scope_verdicts": {"type": "object", "minProperties": 1},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "authorization_scope": {
      "type": "object",
      "required": ["execution_purpose", "required_observables"],
      "properties": {
        "execution_purpose": {"const": "downstream_learning_or_scoring"},
        "required_observables": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "nested_insert_world_segments",
              "world_lineage",
              "silent_drop_detection",
              "xclip_preservation",
              "source_document_identity",
              "native_display_membership",
              "model_input_membership"
            ]
          }
        }
      }
    },
    "downstream_experiment_gate": {
      "type": "object",
      "required": [
        "status",
        "reason_codes",
        "qualification_status",
        "candidate_count",
        "wall_pair_record_count",
        "rules_f1",
        "expected_invariant_statuses",
        "blocked_expected_invariants"
      ],
      "properties": {
        "status": {"enum": ["PASS", "BLOCKED"]},
        "reason_codes": {"type": "array", "items": {"type": "string"}},
        "qualification_status": {"$ref": "#/$defs/status"},
        "candidate_count": {"type": ["integer", "null"]},
        "wall_pair_record_count": {"type": "integer", "minimum": 0},
        "rules_f1": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "expected_invariant_statuses": {"type": "object"},
        "blocked_expected_invariants": {"type": "array", "items": {"type": "string"}}
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/file_record"}
    }
  },
  "$defs": {
    "status": {
      "enum": ["PASS", "PARTIAL_PASS", "PASS_WITH_DEFERRAL", "BLOCKED", "RETRACTED"]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file_record": {
      "type": "object",
      "required": ["role", "path", "sha256", "bytes"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
