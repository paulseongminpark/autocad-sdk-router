{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "inspect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "handles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]+$"
          }
        }
      },
      "required": [
        "handles"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "validate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
